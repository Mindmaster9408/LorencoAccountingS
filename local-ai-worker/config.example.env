# Copy this file to config.env (same folder) and fill it in. config.env is never committed.

# The app(s) to ask for work — Render and/or Zeabur, comma separated. The worker
# sticks to whichever answers; both use the same database.
APP_URLS=https://your-app.onrender.com,https://your-app.zeabur.app

# Must be EXACTLY the same as LOCAL_AI_WORKER_TOKEN on Render/Zeabur (24+ characters).
LOCAL_AI_WORKER_TOKEN=

# Local Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
# Full path if "ollama" is not on PATH for the scheduled task, e.g.
# OLLAMA_EXE=C:\Users\you\AppData\Local\Programs\Ollama\ollama.exe
OLLAMA_EXE=ollama

# Seconds to wait when there is no work
IDLE_SECONDS=20
# Max seconds for one slip (CPU-only computers are slow)
OLLAMA_TIMEOUT_SECONDS=600
# Keep the model loaded between slips (loading takes ~30 s on a CPU-only computer)
OLLAMA_KEEP_ALIVE=24h

# Text model for the help chatbot
OLLAMA_TEXT_MODEL=qwen2.5:3b
# Which jobs this computer does
JOB_KINDS=slip_read,help_answer
